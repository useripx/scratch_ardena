{
  "name": "ardena-playground",
  "version": "1.0.0",
  "description": "Ardena Playground — AI-Assisted Scratch 3.0 Game Studio",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n \"BACKEND,FRONTEND\" -c \"cyan,magenta\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "build:backend": "npm run build --prefix backend",
    "build:frontend": "npm run build --prefix frontend",
    "build": "npm run build:backend && npm run build:frontend",
    "test:backend": "npm test --prefix backend",
    "test:frontend": "npm test --prefix frontend",
    "test": "npm test --prefix backend && npm test --prefix frontend"
  },
  "author": "Yogi Ario",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
