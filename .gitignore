# ==============================================================================
# Ardena Playground — Root .gitignore
# Prinsip: Zero Secret Leakage, Clean Working Tree, Safe Collaboration
# ==============================================================================

# 1. Kredensial & Secrets (CRITICAL — Pilar 3: Zero Secret Leakage)
template/api
.env
.env.*
!.env.example
*.key
*.pem
*.cert
*.pfx

# 2. Dependencies & Package Managers
node_modules/
*/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-store/

# 3. Build & Compilation Outputs
dist/
*/dist/
build/
*/build/
out/
.next/
.turbo/
*.tsbuildinfo

# 4. Testing & Code Coverage
coverage/
*/coverage/
.nyc_output/

# 5. OS & Editor Artifacts
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.sublime-project
*.sublime-workspace
*.sw?
*.bak
*~
*.zip

# 6. Logs & Internal Agent Caches
logs/
*.log
.system_generated/
.gemini/
