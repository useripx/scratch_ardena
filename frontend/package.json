{
  "name": "ardena-playground-frontend",
  "version": "1.0.0",
  "description": "Frontend Web Application for Ardena Playground (Scratch 3.0 AI-assisted Game Creator)",
  "main": "dist/index.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc",
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage"
  },
  "keywords": [
    "scratch",
    "react",
    "ai-copilot",
    "ardena",
    "blockly"
  ],
  "author": "Yogi Ario",
  "license": "ISC",
  "dependencies": {
    "@types/jszip": "^3.4.0",
    "jszip": "^3.10.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "ts-jest": "^29.1.5",
    "typescript": "^5.4.5",
    "vite": "^8.3.6"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "jsdom",
    "roots": [
      "<rootDir>/tests"
    ],
    "testMatch": [
      "**/*.test.ts",
      "**/*.test.tsx"
    ]
  }
}
