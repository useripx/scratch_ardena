# Server Configuration
NODE_ENV=development
PORT=3001

# CORS Allowed Origins (Scratch Editor development server origin)
CORS_ORIGINS=http://localhost:8601,http://localhost:3000

# AI Provider Credentials (Hexa-Cluster Resilience)
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
SAMBANOVA_API_KEY=your_sambanova_api_key_here
NVIDIA_API_KEY=your_nvidia_api_key_here
COHERE_API_KEY=your_cohere_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Timeouts and Limits (in milliseconds)
AI_REQUEST_TIMEOUT_MS=15000
AI_TOTAL_TIMEOUT_MS=45000
